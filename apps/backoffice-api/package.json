{
  "name": "backoffice-api",
  "version": "1.0.0",
  "private": true,
  "description": "API de soporte interno de Cauri: ficha de cliente, KYC y congelar cuentas.",
  "main": "dist/server.js",
  "files": [
    "dist"
  ],
  "engines": {
    "node": ">=20"
  },
  "scripts": {
